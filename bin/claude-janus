#!/usr/bin/env bash
# claude-janus — official Claude Code companion for Janus.
#
# Launches Claude Code through Janus's Anthropic-compatible API with independent
# Opus, Sonnet, and Haiku tier mappings. At startup, choose the tier to launch;
# inside Claude Code, /model can switch between those same saved mappings.
#
# The wrapper is isolated: ~/.zshrc and the ordinary `claude` command remain
# untouched. Janus variables apply only to the launched Claude Code process.
#
# Automation:
#   JANUS_LAUNCHER_CLAUDE_TIER=sonnet claude-janus -p "hello"
#   JANUS_LAUNCHER_DRY_RUN=1 JANUS_LAUNCHER_CLAUDE_TIER=haiku claude-janus
set -euo pipefail
umask 077

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$ROOT_DIR/lib/janus_api.sh" ]]; then
  JANUS_LIB_DIR="$ROOT_DIR/lib"
elif [[ -f "$SCRIPT_DIR/../lib/janus_api.sh" ]]; then
  JANUS_LIB_DIR="$SCRIPT_DIR/../lib"
else
  JANUS_LIB_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/janus-launcher/lib"
fi
# shellcheck source=lib/janus_api.sh
source "$JANUS_LIB_DIR/janus_api.sh"
# shellcheck source=lib/janus_config.sh
source "$JANUS_LIB_DIR/janus_config.sh"
# shellcheck source=lib/janus_runtime.sh
source "$JANUS_LIB_DIR/janus_runtime.sh"
# shellcheck source=lib/janus_ui.sh
source "$JANUS_LIB_DIR/janus_ui.sh"

CLAUDE_BIN="$(janus_resolve_client_executable claude "${BASH_SOURCE[0]}" || true)"
[[ -x "$CLAUDE_BIN" ]] || { printf 'claude-janus: Claude Code binary not found\n' >&2; exit 127; }
if janus_is_top_level_passthrough "$@"; then
  exec "$CLAUDE_BIN" "$@"
fi

if [[ "${JANUS_LAUNCHER_DRY_RUN:-}" == 1 ]]; then
  JANUS_UI_DISABLE=1
fi
janus_ui_init 'CLAUDE CODE · OFFICIAL JANUS COMPANION'
janus_load_validated_service || exit $?

read_reply() { janus_ui_read_reply; }

# ---- Curated Janus routes ---------------------------------------------------
CLAUDE_OPUS="openrouter/anthropic/claude-opus-4.8"
CLAUDE_SONNET="openrouter/anthropic/claude-sonnet-5"
CLAUDE_HAIKU="openrouter/anthropic/claude-haiku-4.5"
DEEPSEEK_PRO="deepseek/deepseek-v4-pro"
DEEPSEEK_FLASH="deepseek/deepseek-v4-flash"
GLM_47="zhipu/glm-4.7"
PRESET_IDS=("$CLAUDE_OPUS" "$CLAUDE_SONNET" "$CLAUDE_HAIKU" "$DEEPSEEK_PRO" "$DEEPSEEK_FLASH" "$GLM_47")
PRESET_LABELS=('Claude Opus 4.8' 'Claude Sonnet 5' 'Claude Haiku 4.5' 'DeepSeek V4 Pro' 'DeepSeek V4 Flash' 'GLM 4.7')
PRESET_NOTES=(
  'OpenRouter-backed; full Claude Code turn verified'
  'OpenRouter-backed; chat and tool loop verified'
  'Adaptive-thinking main turns still fail upstream'
  'Chat and tool loop verified'
  'Fast route; interactive Claude Code verified'
  'Claude Code main turn verified'
)
PRESET_SHORTCUTS=('o' 's' 'h' 'p' 'f' 'g')
CATALOG_JSON="$JANUS_CATALOG_JSON"
CATALOG_STATUS=0

# ---- Saved tier mappings ----------------------------------------------------
CONFIG_FILE="$JANUS_CLAUDE_MAPPINGS"
mkdir -p "$JANUS_CONFIG_DIR"
chmod 700 "$JANUS_CONFIG_DIR" 2>/dev/null || true

OPUS_MODEL="$CLAUDE_OPUS"
SONNET_MODEL="$DEEPSEEK_PRO"
HAIKU_MODEL="$GLM_47"
SUBAGENT_MODEL="$DEEPSEEK_PRO"
DEFAULT_TIER="sonnet"

claude_valid_tier() {
  case "$1" in opus|sonnet|haiku) return 0 ;; *) return 1 ;; esac
}

claude_valid_model_value() {
  [[ -n "$1" && "$1" != *$'\n'* && "$1" != *$'\r'* && "$1" != *'='* ]]
}

claude_load_mappings() {
  local file="$1" line key value line_number=0
  local saw_opus=0 saw_sonnet=0 saw_haiku=0 saw_subagent=0 saw_default=0
  [[ -f "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_number += 1))
    case "$line" in ''|'#'*) continue ;; esac
    [[ "$line" != *$'\r'* ]] || { printf 'claude-janus: invalid mapping configuration at line %d\n' "$line_number" >&2; return 1; }
    key="${line%%=*}"
    [[ "$line" == *=* ]] || { printf 'claude-janus: invalid mapping configuration at line %d\n' "$line_number" >&2; return 1; }
    value="${line#*=}"
    case "$key" in
      OPUS_MODEL) ((saw_opus == 0)) || return 1; saw_opus=1; claude_valid_model_value "$value" || return 1; OPUS_MODEL="$value" ;;
      SONNET_MODEL) ((saw_sonnet == 0)) || return 1; saw_sonnet=1; claude_valid_model_value "$value" || return 1; SONNET_MODEL="$value" ;;
      HAIKU_MODEL) ((saw_haiku == 0)) || return 1; saw_haiku=1; claude_valid_model_value "$value" || return 1; HAIKU_MODEL="$value" ;;
      SUBAGENT_MODEL) ((saw_subagent == 0)) || return 1; saw_subagent=1; claude_valid_model_value "$value" || return 1; SUBAGENT_MODEL="$value" ;;
      DEFAULT_TIER) ((saw_default == 0)) || return 1; saw_default=1; claude_valid_tier "$value" || return 1; DEFAULT_TIER="$value" ;;
      *) printf 'claude-janus: unknown mapping key at line %d\n' "$line_number" >&2; return 1 ;;
    esac
  done < "$file"
  if ((saw_opus + saw_sonnet + saw_haiku + saw_subagent + saw_default != 5)); then
    printf 'claude-janus: mapping configuration must contain all five keys exactly once\n' >&2
    return 1
  fi
}

claude_validate_mappings() {
  local catalog="$1" model
  for model in "$OPUS_MODEL" "$SONNET_MODEL" "$HAIKU_MODEL" "$SUBAGENT_MODEL"; do
    if ! janus_catalog_contains "$catalog" "$model"; then
      printf 'claude-janus: mapped model is not advertised by Janus: %s\n' "$model" >&2
      return 1
    fi
  done
}

claude_save_mappings() {
  local file="$1" temporary directory
  directory="$(dirname -- "$file")"
  mkdir -p -- "$directory" && chmod 700 -- "$directory" || return 1
  temporary="$(mktemp "$directory/.claude-mappings.conf.XXXXXX")" || return 1
  if ! printf 'OPUS_MODEL=%s\nSONNET_MODEL=%s\nHAIKU_MODEL=%s\nSUBAGENT_MODEL=%s\nDEFAULT_TIER=%s\n' \
    "$OPUS_MODEL" "$SONNET_MODEL" "$HAIKU_MODEL" "$SUBAGENT_MODEL" "$DEFAULT_TIER" > "$temporary" ||
    ! chmod 600 "$temporary" || ! mv -fT -- "$temporary" "$file"; then
    rm -f -- "$temporary"
    return 1
  fi
}

CLAUDE_MAPPINGS_MISSING=0
if [[ -e "$CONFIG_FILE" ]]; then
  claude_load_mappings "$CONFIG_FILE" || { printf 'claude-janus: invalid Claude mappings: %s\n' "$CONFIG_FILE" >&2; exit 2; }
else
  CLAUDE_MAPPINGS_MISSING=1
fi
if ((CLAUDE_MAPPINGS_MISSING == 0)); then
  claude_validate_mappings "$CATALOG_JSON" || exit 2
fi

valid_tier() { claude_valid_tier "$@"; }
valid_model_value() { claude_valid_model_value "$@"; }
CLAUDE_INITIAL_CONFIGURING=0
save_config() {
  ((CLAUDE_INITIAL_CONFIGURING)) || claude_save_mappings "$CONFIG_FILE"
}

# ---- Terminal UI ------------------------------------------------------------
# Full-screen menus are enabled only for an actual interactive terminal. Piped
# input, dry-runs, --help, and tier automation stay scroll-safe.
MENU_USED=0
UI_ENABLED="$JANUS_UI_ENABLED"

# Compatibility names keep the existing Claude-specific call sites unchanged
# while terminal state and rendering live behind the shared UI boundary.
menu_tty_raw() { janus_ui_tty_raw; }
menu_tty_restore() { janus_ui_tty_restore; }
read_menu_key() { janus_ui_read_key; MENU_KEY="$JANUS_UI_KEY"; }
menu_navigate() {
  janus_ui_navigate "$@"
  MENU_RESULT="$JANUS_UI_RESULT"
}
clear_screen() { janus_ui_clear; }
prepare_screen() { janus_ui_prepare_screen; }
screen_header() { janus_ui_header "$@"; }
pause_screen() { janus_ui_pause; }
show_message() { janus_ui_message "$@"; }

model_label() {
  case "$1" in
    "$CLAUDE_OPUS")    printf 'Claude Opus 4.8' ;;
    "$CLAUDE_SONNET")  printf 'Claude Sonnet 5' ;;
    "$CLAUDE_HAIKU")   printf 'Claude Haiku 4.5' ;;
    "$DEEPSEEK_PRO")   printf 'DeepSeek V4 Pro' ;;
    "$DEEPSEEK_FLASH") printf 'DeepSeek V4 Flash' ;;
    "$GLM_47")         printf 'GLM 4.7' ;;
    *)                  printf '%s' "$1" ;;
  esac
}

model_badge() {
  case "$1" in
    "$CLAUDE_OPUS"|"$CLAUDE_SONNET"|"$DEEPSEEK_PRO"|"$DEEPSEEK_FLASH"|"$GLM_47")
      printf '%sREADY%s' "$GREEN" "$RESET" ;;
    "$CLAUDE_HAIKU")
      printf '%sLIMITED%s' "$YELLOW" "$RESET" ;;
    *)
      printf '%sCUSTOM%s' "$MAGENTA" "$RESET" ;;
  esac
}

mapping_label() {
  case "$1" in
    opus) printf 'Opus' ;;
    sonnet) printf 'Sonnet' ;;
    haiku) printf 'Haiku' ;;
    subagent) printf 'Subagent' ;;
  esac
}

tier_label() {
  mapping_label "$1"
}

claude_model_for_tier() {
  case "$1" in
    opus) printf '%s' "$OPUS_MODEL" ;;
    sonnet) printf '%s' "$SONNET_MODEL" ;;
    haiku) printf '%s' "$HAIKU_MODEL" ;;
  esac
}

print_mapping_row() {
  local role="$1" model="$2" marker=' '
  [[ "$role" == subagent || "$role" != "$DEFAULT_TIER" ]] || marker='●'
  printf '  %s%s %-9s%s  %s%-26s%s  [%s]\n' \
    "$CYAN" "$marker" "$(mapping_label "$role")" "$RESET" \
    "$BOLD" "$(model_label "$model")" "$RESET" "$(model_badge "$model")" >&2
  printf '      %s%s%s\n' "$DIM" "$model" "$RESET" >&2
}

print_mappings() {
  printf '%sSAVED MODEL MAP%s  %s● default startup tier%s\n\n' "$BOLD" "$RESET" "$DIM" "$RESET" >&2
  print_mapping_row opus "$OPUS_MODEL"
  print_mapping_row sonnet "$SONNET_MODEL"
  print_mapping_row haiku "$HAIKU_MODEL"
  print_mapping_row subagent "$SUBAGENT_MODEL"
}

menu_choice() { janus_ui_choice "$@"; }

print_model_option() {
  local cursor="$1" number="$2" label="$3" model="$4" note="${5:-}"
  menu_choice "$cursor" "$number" "$number" "$label" "[$(model_badge "$model")]"
  printf '         %s%s%s\n' "$DIM" "$model" "$RESET" >&2
  [[ -z "$note" ]] || printf '         %s%s%s\n' "$YELLOW" "$note" "$RESET" >&2
}

load_catalog() {
  if [[ -n "$CATALOG_JSON" || $CATALOG_STATUS -ne 0 ]]; then
    [[ -n "$CATALOG_JSON" ]]
    return $?
  fi
  if CATALOG_JSON="$(janus_fetch_catalog "$JANUS_BASE_URL" "$JANUS_API_KEY" 2>/dev/null)"; then
    if [[ -z "$(janus_extract_model_ids "$CATALOG_JSON")" ]]; then
      CATALOG_STATUS=1
      CATALOG_JSON=""
      return 1
    fi
    return 0
  fi
  CATALOG_STATUS=1
  CATALOG_JSON=""
  return 1
}

# Return 0 if exact model exists, 1 if catalog is reachable but it does not,
# and 2 if the authenticated catalog cannot be checked.
model_exists() {
  load_catalog || return 2
  janus_catalog_contains "$CATALOG_JSON" "$1"
}

pick_custom_model() {
  local target_var="$1" current="$2" custom rc
  screen_header "Use a custom Janus model" "The ID will be checked against authenticated /v1/models"
  printf 'Current  %s%s%s\n\n' "$DIM" "$current" "$RESET" >&2
  printf 'Exact model ID %s[Enter cancels]%s: ' "$DIM" "$RESET" >&2
  custom="$(read_reply)"
  [[ -n "$custom" ]] || return 1
  if ! valid_model_value "$custom"; then
    show_message error "Invalid model ID" "The value cannot be empty or contain '=' or a newline."
    return 1
  fi

  if model_exists "$custom"; then
    printf -v "$target_var" '%s' "$custom"
    return 0
  else
    rc=$?
    if [[ $rc -eq 1 ]]; then
      show_message error "Model not found" "Janus did not advertise '$custom'; the current mapping was kept."
      return 1
    fi
    show_message warning "Catalog unavailable" "The ID could not be validated, so it will be saved as entered."
    printf -v "$target_var" '%s' "$custom"
    return 0
  fi
}

TIER_MENU_IDS=()
TIER_MENU_LABELS=()
TIER_MENU_NOTES=()
TIER_MENU_SHORTCUTS=""
TIER_MENU_CUSTOM_INDEX=0
TIER_MENU_COUNT=0

tier_menu_has_preset() {
  local id="$1" preset
  for preset in "${PRESET_IDS[@]}"; do
    [[ "$id" != "$preset" ]] || return 0
  done
  return 1
}

tier_menu_add_model() {
  local id="$1" label="$2" note="${3:-}" shortcut="${4:-$'\001'}"
  TIER_MENU_IDS+=("$id")
  TIER_MENU_LABELS+=("$label")
  TIER_MENU_NOTES+=("$note")
  TIER_MENU_SHORTCUTS+="$shortcut"
}

build_tier_model_menu() {
  local i id extras=0
  TIER_MENU_IDS=()
  TIER_MENU_LABELS=()
  TIER_MENU_NOTES=()
  TIER_MENU_SHORTCUTS=""
  if load_catalog; then
    for i in "${!PRESET_IDS[@]}"; do
      if janus_catalog_contains "$CATALOG_JSON" "${PRESET_IDS[$i]}"; then
        tier_menu_add_model "${PRESET_IDS[$i]}" "${PRESET_LABELS[$i]}" "${PRESET_NOTES[$i]}" "${PRESET_SHORTCUTS[$i]}"
      fi
    done
    while IFS= read -r id && (( extras < 20 )); do
      [[ -n "$id" ]] || continue
      tier_menu_has_preset "$id" && continue
      tier_menu_add_model "$id" "From Janus: $(model_label "$id")"
      (( extras += 1 ))
    done < <(janus_extract_model_ids "$CATALOG_JSON")
  else
    for i in "${!PRESET_IDS[@]}"; do
      tier_menu_add_model "${PRESET_IDS[$i]}" "${PRESET_LABELS[$i]}" "${PRESET_NOTES[$i]}" "${PRESET_SHORTCUTS[$i]}"
    done
  fi
  TIER_MENU_CUSTOM_INDEX="$((${#TIER_MENU_IDS[@]} + 1))"
  TIER_MENU_COUNT="$TIER_MENU_CUSTOM_INDEX"
  TIER_MENU_SHORTCUTS+="c"
}

tier_menu_cursor_for_model() {
  local model="$1" i
  for i in "${!TIER_MENU_IDS[@]}"; do
    if [[ "$model" == "${TIER_MENU_IDS[$i]}" ]]; then
      printf '%s' "$((i + 1))"
      return 0
    fi
  done
  printf '%s' "$TIER_MENU_CUSTOM_INDEX"
}

TIER_MENU_SELECTED=""
tier_menu_select_reply() {
  local reply="$1" index
  TIER_MENU_SELECTED=""
  if [[ "$reply" =~ ^[0-9]+$ ]]; then
    index=$((10#$reply))
    if (( index >= 1 && index <= TIER_MENU_COUNT )); then
      (( index == TIER_MENU_CUSTOM_INDEX )) && return 1
      TIER_MENU_SELECTED="${TIER_MENU_IDS[$((index - 1))]}"
      return 0
    fi
    return 2
  fi
  case "$reply" in
    o|O|opus|Opus) TIER_MENU_SELECTED="$CLAUDE_OPUS" ;;
    s|S|sonnet|Sonnet) TIER_MENU_SELECTED="$CLAUDE_SONNET" ;;
    h|H|haiku|Haiku) TIER_MENU_SELECTED="$CLAUDE_HAIKU" ;;
    p|P|pro|Pro) TIER_MENU_SELECTED="$DEEPSEEK_PRO" ;;
    f|F|flash|Flash) TIER_MENU_SELECTED="$DEEPSEEK_FLASH" ;;
    g|G|glm|GLM) TIER_MENU_SELECTED="$GLM_47" ;;
    c|C|custom|Custom) return 1 ;;
    *) return 2 ;;
  esac
  tier_menu_has_model "$TIER_MENU_SELECTED" || return 2
}

tier_menu_has_model() {
  local id="$1" model
  for model in "${TIER_MENU_IDS[@]}"; do
    [[ "$id" != "$model" ]] || return 0
  done
  return 1
}

render_mapping_model_menu() {
  local cursor="$1" role="$2" current="$3" i number
  screen_header "Map the $(mapping_label "$role") model" "Current: $(model_label "$current") · $current"
  for i in "${!TIER_MENU_IDS[@]}"; do
    number="$((i + 1))"
    print_model_option "$cursor" "$number" "${TIER_MENU_LABELS[$i]}" "${TIER_MENU_IDS[$i]}" "${TIER_MENU_NOTES[$i]}"
  done
  menu_choice "$cursor" "$TIER_MENU_CUSTOM_INDEX" "$TIER_MENU_CUSTOM_INDEX" 'Enter another exact Janus model ID'
  printf '\n  %s↑/↓ move · Enter select · Esc back%s\n' "$DIM" "$RESET" >&2
}

configure_mapping() {
  local role="$1" target_var current reply selected="" cursor=1 select_rc
  case "$role" in
    opus) target_var="OPUS_MODEL"; current="$OPUS_MODEL" ;;
    sonnet) target_var="SONNET_MODEL"; current="$SONNET_MODEL" ;;
    haiku) target_var="HAIKU_MODEL"; current="$HAIKU_MODEL" ;;
    subagent) target_var="SUBAGENT_MODEL"; current="$SUBAGENT_MODEL" ;;
  esac
  build_tier_model_menu
  cursor="$(tier_menu_cursor_for_model "$current")"

  while true; do
    if [[ $UI_ENABLED -eq 1 ]]; then
      menu_navigate "$TIER_MENU_COUNT" "$cursor" render_mapping_model_menu "$TIER_MENU_SHORTCUTS" "$role" "$current"
      reply="$MENU_RESULT"
      [[ "$reply" != back ]] || return 0
      cursor="$reply"
    else
      render_mapping_model_menu 0 "$role" "$current"
      printf 'Choice [Enter keeps current]: ' >&2
      reply="$(read_reply)"
    fi

    case "$reply" in
      ""|b|B) return 0 ;;
      *)
        if tier_menu_select_reply "$reply"; then
          select_rc=0
        else
          select_rc=$?
        fi
        case "$select_rc" in
          0) selected="$TIER_MENU_SELECTED" ;;
          1)
            if pick_custom_model "$target_var" "$current"; then
              save_config
              show_message success "Mapping saved" "$(mapping_label "$role") now uses $(model_label "${!target_var}")."
            fi
            return 0
            ;;
          *)
            show_message error "Unknown choice" "Choose a shown number, B, or press Enter."
            continue
            ;;
        esac
        ;;
    esac

    printf -v "$target_var" '%s' "$selected"
    save_config
    show_message success "Mapping saved" "$(mapping_label "$role") now uses $(model_label "$selected")."
    return 0
  done
}

render_default_tier_menu() {
  local cursor="$1"
  screen_header "Choose the default startup tier" "Pressing Enter on launch will use this tier"
  menu_choice "$cursor" 1 1 "Opus    → $(model_label "$OPUS_MODEL")"
  menu_choice "$cursor" 2 2 "Sonnet  → $(model_label "$SONNET_MODEL")"
  menu_choice "$cursor" 3 3 "Haiku   → $(model_label "$HAIKU_MODEL")"
  printf '\n  %s↑/↓ move · Enter select · Esc back · 1–3 shortcut%s\n' "$DIM" "$RESET" >&2
}

configure_default_tier() {
  local reply cursor=1
  case "$DEFAULT_TIER" in opus) cursor=1;; sonnet) cursor=2;; haiku) cursor=3;; esac
  if [[ $UI_ENABLED -eq 1 ]]; then
    menu_navigate 3 "$cursor" render_default_tier_menu 'osh'
    reply="$MENU_RESULT"
    [[ "$reply" != back ]] || return 0
  else
    render_default_tier_menu 0
    printf 'Choice [Enter keeps %s]: ' "$(tier_label "$DEFAULT_TIER")" >&2
    reply="$(read_reply)"
  fi
  case "$reply" in
    "") return 0 ;;
    1|o|O|opus|Opus) DEFAULT_TIER="opus" ;;
    2|s|S|sonnet|Sonnet) DEFAULT_TIER="sonnet" ;;
    3|h|H|haiku|Haiku) DEFAULT_TIER="haiku" ;;
    *) show_message error "Unknown choice" "The default tier was not changed."; return 0 ;;
  esac
  save_config
  show_message success "Default updated" "$(tier_label "$DEFAULT_TIER") will be preselected at startup."
}

render_config_menu() {
  local cursor="$1"
  screen_header "Configure model mappings" "Changes are saved to $CONFIG_FILE"
  print_mappings
  printf '\n%sEDIT%s\n\n' "$BOLD" "$RESET" >&2
  menu_choice "$cursor" 1 1 'Change Opus mapping'
  menu_choice "$cursor" 2 2 'Change Sonnet mapping'
  menu_choice "$cursor" 3 3 'Change Haiku mapping'
  menu_choice "$cursor" 4 4 'Change subagent mapping'
  menu_choice "$cursor" 5 5 'Change default startup tier'
  printf '\n  %s↑/↓ move · Enter select · Esc back · 1–5 shortcut%s\n' "$DIM" "$RESET" >&2
}

configure_menu() {
  local reply cursor=1
  while true; do
    if [[ $UI_ENABLED -eq 1 ]]; then
      menu_navigate 5 "$cursor" render_config_menu 'oshad'
      reply="$MENU_RESULT"
      [[ "$reply" != back ]] || return 0
      cursor="$reply"
    else
      render_config_menu 0
      printf 'Choice: ' >&2
      reply="$(read_reply)"
    fi
    case "$reply" in
      1|o|O|opus|Opus) configure_mapping opus ;;
      2|s|S|sonnet|Sonnet) configure_mapping sonnet ;;
      3|h|H|haiku|Haiku) configure_mapping haiku ;;
      4|a|A|agent|Agent|subagent|Subagent) configure_mapping subagent ;;
      5|d|D|default|Default) configure_default_tier ;;
      ""|b|B) return 0 ;;
      *) show_message error "Unknown choice" "Choose 1–5 or B." ;;
    esac
  done
}

claude_configure_initial_mappings() {
  local role first_model
  janus_ui_is_interactive || {
    printf 'claude-janus: Claude mappings are missing: %s\n' "$CONFIG_FILE" >&2
    printf 'Run claude-janus interactively to configure Opus, Sonnet, Haiku, and subagent mappings.\n' >&2
    return 2
  }
  first_model="$(janus_extract_model_ids "$CATALOG_JSON" | while IFS= read -r model; do printf '%s' "$model"; break; done)"
  [[ -n "$first_model" ]] || return 2
  OPUS_MODEL="$first_model"
  SONNET_MODEL="$first_model"
  HAIKU_MODEL="$first_model"
  SUBAGENT_MODEL="$first_model"
  screen_header 'Initial Claude mapping setup' 'Choose a catalog model for each Claude role; nothing is saved until all four are valid.'
  CLAUDE_INITIAL_CONFIGURING=1
  for role in opus sonnet haiku subagent; do
    configure_mapping "$role"
  done
  CLAUDE_INITIAL_CONFIGURING=0
  claude_validate_mappings "$CATALOG_JSON" || return 2
  claude_save_mappings "$CONFIG_FILE" || {
    printf 'claude-janus: cannot save Claude mappings: %s\n' "$CONFIG_FILE" >&2
    return 2
  }
}

if ((CLAUDE_MAPPINGS_MISSING)); then
  claude_configure_initial_mappings || exit $?
fi

render_startup_menu() {
  local cursor="$1"
  screen_header "Choose a Claude Code tier" "Select a mapping for this session, or press Enter for the highlighted tier"
  print_mappings
  printf '\n%sSTART SESSION%s\n\n' "$BOLD" "$RESET" >&2
  menu_choice "$cursor" 1 1 "Opus    → $(model_label "$OPUS_MODEL")"
  menu_choice "$cursor" 2 2 "Sonnet  → $(model_label "$SONNET_MODEL")"
  menu_choice "$cursor" 3 3 "Haiku   → $(model_label "$HAIKU_MODEL")"
  menu_choice "$cursor" 4 4 'Configure mappings'
  printf '\n  %s↑/↓ move · Enter select · Esc/Q cancel · 1–4 shortcut%s\n' "$DIM" "$RESET" >&2
}

# ---- Determine startup tier -------------------------------------------------
START_TIER="$DEFAULT_TIER"
HAS_MODEL_ARG=0
CLAUDE_CALLER_MODEL=""
CLAUDE_USER_ARGS=()

claude_parse_arguments() {
  local expect_model_value=0 parsing_options=1 arg
  HAS_MODEL_ARG=0
  CLAUDE_CALLER_MODEL=""
  CLAUDE_USER_ARGS=("$@")
  for arg in "$@"; do
    if ((parsing_options)) && [[ "$arg" == -- ]]; then
      parsing_options=0
      continue
    fi
    ((parsing_options)) || continue
    if [[ $expect_model_value -eq 1 ]]; then
      [[ -n "$arg" ]] || { printf 'claude-janus: --model requires a value\n' >&2; return 2; }
      HAS_MODEL_ARG=1
      CLAUDE_CALLER_MODEL="$arg"
      expect_model_value=0
      continue
    fi
    case "$arg" in
      --model) expect_model_value=1 ;;
      --model=*)
        CLAUDE_CALLER_MODEL="${arg#--model=}"
        [[ -n "$CLAUDE_CALLER_MODEL" ]] || { printf 'claude-janus: --model requires a value\n' >&2; return 2; }
        HAS_MODEL_ARG=1
        ;;
    esac
  done
  [[ $expect_model_value -eq 0 ]] || { printf 'claude-janus: --model requires a value\n' >&2; return 2; }
}

claude_parse_arguments "$@" || exit $?
if [[ $HAS_MODEL_ARG -eq 1 ]] && ! janus_catalog_contains "$CATALOG_JSON" "$CLAUDE_CALLER_MODEL"; then
  printf 'claude-janus: caller model is not advertised by Janus: %s\n' "$CLAUDE_CALLER_MODEL" >&2
  exit 2
fi

if [[ -n "${JANUS_LAUNCHER_CLAUDE_TIER:-}" ]]; then
  if ! claude_valid_tier "$JANUS_LAUNCHER_CLAUDE_TIER"; then
    printf 'claude-janus: JANUS_LAUNCHER_CLAUDE_TIER must be opus, sonnet, or haiku\n' >&2
    exit 2
  fi
  START_TIER="$JANUS_LAUNCHER_CLAUDE_TIER"
elif [[ $HAS_MODEL_ARG -eq 0 ]]; then
  MENU_USED=1
  startup_cursor=1
  case "$DEFAULT_TIER" in opus) startup_cursor=1;; sonnet) startup_cursor=2;; haiku) startup_cursor=3;; esac
  while true; do
    if [[ $UI_ENABLED -eq 1 ]]; then
      menu_navigate 4 "$startup_cursor" render_startup_menu 'oshc'
      reply="$MENU_RESULT"
      if [[ "$reply" == back ]]; then
        clear_screen
        printf '%sCancelled.%s\n' "$DIM" "$RESET" >&2
        exit 0
      fi
      startup_cursor="$reply"
    else
      render_startup_menu 0
      printf 'Choice [Enter = %s]: ' "$(tier_label "$DEFAULT_TIER")" >&2
      reply="$(read_reply)"
    fi
    case "$reply" in
      "") START_TIER="$DEFAULT_TIER"; break ;;
      1|o|O|opus|Opus) START_TIER="opus"; DEFAULT_TIER="opus"; save_config; break ;;
      2|s|S|sonnet|Sonnet) START_TIER="sonnet"; DEFAULT_TIER="sonnet"; save_config; break ;;
      3|h|H|haiku|Haiku) START_TIER="haiku"; DEFAULT_TIER="haiku"; save_config; break ;;
      4|c|C|config|configure)
        configure_menu
        case "$DEFAULT_TIER" in
          opus) startup_cursor=1 ;;
          sonnet) startup_cursor=2 ;;
          haiku) startup_cursor=3 ;;
        esac
        ;;
      q|Q|quit|exit)
        clear_screen
        printf '%sCancelled.%s\n' "$DIM" "$RESET" >&2
        exit 0
        ;;
      *) show_message error "Unknown choice" "Choose 1–4, Q, or press Enter." ;;
    esac
  done
fi

# ---- Isolated Claude Code environment --------------------------------------
export ANTHROPIC_BASE_URL="$JANUS_BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$JANUS_API_KEY"
export ANTHROPIC_API_KEY="" # explicit blank prevents Anthropic/OAuth fallback
unset OPENROUTER_API_KEY 2>/dev/null || true
unset ANTHROPIC_MODEL 2>/dev/null || true # do not fight Claude's tier selector

export ANTHROPIC_DEFAULT_OPUS_MODEL="$OPUS_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$SONNET_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$HAIKU_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$SUBAGENT_MODEL"

command=("$CLAUDE_BIN")
if [[ $HAS_MODEL_ARG -eq 0 ]]; then
  command+=(--model "$START_TIER")
fi
command+=("$@")

SELECTED_MODEL="$(claude_model_for_tier "$START_TIER")"

# Remove wrapper screens before Claude Code draws its own TUI. Automation and
# dry-run invocations never clear the caller's terminal.
if [[ $MENU_USED -eq 1 && $UI_ENABLED -eq 1 ]]; then
  clear_screen
fi
printf '%s→ Janus%s  %s%s tier%s → %s\n' \
  "$CYAN" "$RESET" "$BOLD" "$(tier_label "$START_TIER")" "$RESET" \
  "$(model_label "$SELECTED_MODEL")" >&2

if [[ "${JANUS_LAUNCHER_DRY_RUN:-}" == 1 ]]; then
  printf '[dry-run] would exec:'
  printf ' %q' "${command[@]}"
  printf '\n'
  printf '[dry-run] ANTHROPIC_BASE_URL=%s\n' "$ANTHROPIC_BASE_URL"
  printf '[dry-run] ANTHROPIC_DEFAULT_OPUS_MODEL=%s\n' "$ANTHROPIC_DEFAULT_OPUS_MODEL"
  printf '[dry-run] ANTHROPIC_DEFAULT_SONNET_MODEL=%s\n' "$ANTHROPIC_DEFAULT_SONNET_MODEL"
  printf '[dry-run] ANTHROPIC_DEFAULT_HAIKU_MODEL=%s\n' "$ANTHROPIC_DEFAULT_HAIKU_MODEL"
  printf '[dry-run] CLAUDE_CODE_SUBAGENT_MODEL=%s\n' "$CLAUDE_CODE_SUBAGENT_MODEL"
  printf '[dry-run] ANTHROPIC_MODEL=%s\n' "${ANTHROPIC_MODEL-<unset>}"
  printf '[dry-run] ANTHROPIC_AUTH_TOKEN=<set> ANTHROPIC_API_KEY=%q\n' "$ANTHROPIC_API_KEY"
  exit 0
fi

exec "${command[@]}"
